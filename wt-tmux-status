#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# wt-tmux-status — right-hand status segment for tmux
#
# Prints:   <worktree>   <branch>  󰛳 <api>/<web>
#
# Ports come from the session environment `wt` sets
# (WT_API_PORT / WT_WEB_PORT), falling back to the wt registry.
# Branch is read live from the current pane's directory, so it
# follows checkouts without restarting the session.
#
# Usage: wt-tmux-status <session_name> <pane_current_path>
# ─────────────────────────────────────────────────────────────

sess="${1:-}"
path="${2:-$PWD}"

[[ -d "$path" ]] || path="$HOME"

# ── Styling ──────────────────────────────────────────────────
C_NAME="#[fg=colour117,bold]"
C_BRANCH="#[fg=colour215]"
C_SEP="#[fg=colour238]"
C_DIM="#[fg=colour242]"
C_UP="#[fg=colour114,bold]"    # listening
C_DOWN="#[fg=colour244]"       # nothing bound
C_OFF="#[fg=default,nobold]"

# ── Worktree / repo name ─────────────────────────────────────
# `wt` names its sessions "wt/<name>"; anything else falls back
# to the git repo directory, then to the raw session name.
name="${sess#wt/}"
if [[ "$name" == "$sess" ]]; then
  root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
  [[ -n "$root" ]] && name="$(basename "$root")"
fi

# ── Branch ───────────────────────────────────────────────────
branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [[ -z "$branch" ]]; then
  # detached HEAD — show the short sha instead
  short=$(git -C "$path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n "$short" ]] && branch="@$short"
fi

max=${WT_STATUS_BRANCH_MAX:-26}
if (( ${#branch} > max )); then
  branch="${branch:0:max-1}…"
fi

# ── Ports ────────────────────────────────────────────────────
env_port() {
  tmux show-environment -t "=$sess" "$1" 2>/dev/null \
    | sed -n "s/^$1=//p"
}

api=$(env_port WT_API_PORT)
web=$(env_port WT_WEB_PORT)

# Fallback: look the worktree up in the wt registry by path.
if [[ -z "$api$web" ]]; then
  root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n "$root" ]]; then
    line=$(awk -F'|' -v p="$root" '$3 == p {print; exit}' \
      "$HOME"/.config/wt/*/registry 2>/dev/null || true)
    if [[ -n "$line" ]]; then
      api=$(cut -d'|' -f4 <<<"$line")
      web=$(cut -d'|' -f5 <<<"$line")
    fi
  fi
fi

# ── Liveness ─────────────────────────────────────────────────
# A dev server is "up" when something is listening on its port.
# bash's /dev/tcp avoids forking lsof/nc on every status redraw;
# a local connect either succeeds or is refused immediately.
port_up() {
  local p="$1"
  [[ -n "$p" && "$p" != 0 ]] || return 1
  (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null
}

api_up=0; web_up=0
port_up "$api" && api_up=1
port_up "$web" && web_up=1

# Publish onto the api/web *windows* so their formats can colour
# the icon — tmux formats can't shell out per window. Window
# scope means no other window inherits the flag. Only written on
# change, so an idle session causes no extra status redraws.
publish_win() {
  local win="$1" val="$2"
  [[ -n "$sess" ]] || return 0
  local cur
  cur=$(tmux show-options -wqv -t "$sess:$win" @wt_srv_up 2>/dev/null)
  [[ "$cur" == "$val" ]] || \
    tmux set-option -w -t "$sess:$win" @wt_srv_up "$val" 2>/dev/null
}

publish_win api "$api_up"
publish_win web "$web_up"

# ── Assemble ─────────────────────────────────────────────────
out=""
[[ -n "$name"   ]] && out+="${C_NAME}  ${name}${C_OFF}"
[[ -n "$branch" ]] && out+="${C_SEP}  ${C_BRANCH} ${branch}${C_OFF}"

if [[ -n "$api" && -n "$web" && "$api" != 0 ]]; then
  a_col=$([[ "$api_up" == 1 ]] && echo "$C_UP" || echo "$C_DOWN")
  w_col=$([[ "$web_up" == 1 ]] && echo "$C_UP" || echo "$C_DOWN")
  out+="${C_SEP}  ${C_DIM}󰛳 ${a_col}${api}${C_DIM}/${w_col}${web}${C_OFF}"
fi

printf '%s ' "$out"
