  echo "  wt supervise 6517                    # Fix stack containing PR #6517"
  echo ""
  echo -e "${BOLD}PORTS${NC}"
  echo "  Main repo:       API=$BASE_API_PORT  Web=$BASE_WEB_PORT"
  echo "  Each worktree gets the next available port pair (8081/3001, 8082/3002, ...)"
  echo ""
  echo -e "${BOLD}TMUX${NC}"
  echo "  Each worktree gets a tmux session 'wt/<name>' with windows:"
  echo "    1:shell  2:claude  3:vscode  4:api  5:web"
  echo ""
  echo -e "  ${CYAN}Ctrl-b w${NC}     Window picker (all sessions — best for jumping around)"
  echo -e "  ${CYAN}Ctrl-b s${NC}     Session picker"
  echo -e "  ${CYAN}Ctrl-b 1-5${NC}   Switch window (vscode/claude/shell/api/web)"
  echo -e "  ${CYAN}Alt-[${NC}        Previous session"
  echo -e "  ${CYAN}Alt-]${NC}        Next session"
  echo -e "  ${CYAN}Ctrl-b L${NC}     Last (most recent) session"
  echo -e "  ${CYAN}Ctrl-b W${NC}     Show worktree ports/status popup"
  echo ""
  echo -e "${BOLD}CONFIG${NC}"
  echo "  Registry: ~/.config/wt/<repo-name>/registry"
  echo ""
}

# ── Main ─────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"
  shift || true

  # help doesn't need a repo
  if [[ "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
    # Provide defaults for help display
    BASE_API_PORT=8080
    BASE_WEB_PORT=3000
    cmd_help
    return
  fi

  detect_repo

  case "$cmd" in
    create|c)        cmd_create "$@" ;;
    list|ls)         cmd_list ;;
    switch|s)        cmd_switch "$@" ;;
    remove|rm)       cmd_remove "$@" ;;
    restart)         cmd_restart "$@" ;;
    stop)            cmd_stop "$@" ;;
    supervise|sv)    cmd_supervise "$@" ;;
    status|st)       cmd_status "$@" ;;
    *)               die "Unknown command: $cmd. Run 'wt help' for usage." ;;
  esac
}

main "$@"
