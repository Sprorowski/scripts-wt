# ── Main ─────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"
  shift || true

  # help doesn't need a repo
  if [[ "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
    # Provide defaults for help display
    BASE_API_PORT=8080
    BASE_WEB_PORT=3000
    cmd_help
    return
  fi

  detect_repo

  case "$cmd" in
    create|c)        cmd_create "$@" ;;
    list|ls)         cmd_list ;;
    switch|s)        cmd_switch "$@" ;;
    remove|rm)       cmd_remove "$@" ;;
    restart)         cmd_restart "$@" ;;
    stop)            cmd_stop "$@" ;;
    supervise|sv)    cmd_supervise "$@" ;;
    status|st)       cmd_status "$@" ;;
    isolatedb|idb)   cmd_isolatedb "$@" ;;
    dropdb)          cmd_dropdb "$@" ;;
    *)               die "Unknown command: $cmd. Run 'wt help' for usage." ;;
  esac
}

main "$@"
